+// Workspace rows, like niri's overview: one row per workspace, top to bottom
+// by row key, and one zoom for every window so they keep their real relative
+// sizes. A row runs left to right in on-screen order and is shifted so its
+// focused window sits in the middle. The zoom shrinks from maxScale to fit the
+// rows, but not below minScale: past that the rows are taller than the area
+// and scroll, as does any row wider than it (see scrolledRows).
+// items: { row, height, ratio, x, y, focused } with height in desktop pixels.
+// Returns card rectangles indexed like items, each with its row key, plus
+// contentHeight for the whole stack.
+function computeWorkspaceRows(items, width, height, gap, padding, footerHeight, maxScale, minScale) {
+    var result = [];
+    if (!items.length || width <= 0 || height <= 0)
+        return result;
+
+    var membersByKey = {};
+    var rowKeys = [];
+    for (var itemIndex = 0; itemIndex < items.length; itemIndex++) {
+        var key = Number(items[itemIndex].row);
+        if (!membersByKey.hasOwnProperty(String(key))) {
+            membersByKey[String(key)] = [];
+            rowKeys.push(key);
+        }
+        membersByKey[String(key)].push(itemIndex);
+    }
+    rowKeys.sort(function (a, b) { return a - b; });
+
+    var footerSpacing = footerHeight > 0 ? padding : 0;
+    var chrome = padding * 2 + footerHeight + footerSpacing;
+    var perRow = (height - (rowKeys.length - 1) * gap) / rowKeys.length;
+    var scale = maxScale > 0 ? maxScale : 1;
+    var rows = [];
+    for (var keyIndex = 0; keyIndex < rowKeys.length; keyIndex++) {
+        var members = membersByKey[String(rowKeys[keyIndex])].slice();
+        members.sort(function (a, b) {
+            return (items[a].x - items[b].x) || (items[a].y - items[b].y) || (a - b);
+        });
+        var tallest = 1;
+        for (var memberIndex = 0; memberIndex < members.length; memberIndex++)
+            tallest = Math.max(tallest, items[members[memberIndex]].height || 1);
+        scale = Math.min(scale, (perRow - chrome) / tallest);
+        rows.push({ members: members, tallest: tallest });
+    }
+    scale = Math.max(scale, minScale > 0 ? minScale : 0.01);
+
+    var total = (rows.length - 1) * gap;
+    for (var sizeIndex = 0; sizeIndex < rows.length; sizeIndex++) {
+        rows[sizeIndex].height = scale * rows[sizeIndex].tallest + chrome;
+        total += rows[sizeIndex].height;
+    }
+
+    // Rows that fit are centred; a taller stack starts half a gap from the top.
+    var overflows = total > height;
+    var top = overflows ? gap / 2 : (height - total) / 2;
+    result.contentHeight = overflows ? total + gap : height;
+    for (var rowIndex = 0; rowIndex < rows.length; rowIndex++) {
+        var row = rows[rowIndex];
+        var cards = [];
+        var left = 0;
+        var centre = null;
+        for (var cardIndex = 0; cardIndex < row.members.length; cardIndex++) {
+            var item = items[row.members[cardIndex]];
+            var previewHeight = scale * (item.height || 1);
+            var card = {
+                index: row.members[cardIndex],
+                x: left,
+                width: previewHeight * item.ratio + padding * 2,
+                height: previewHeight + chrome
+            };
+            if (item.focused && centre === null)
+                centre = card.x + card.width / 2;
+            cards.push(card);
+            left += card.width + gap;
+        }
+        if (centre === null)
+            centre = cards[0].x + cards[0].width / 2;
+        var shift = width / 2 - centre;
+        for (var placedIndex = 0; placedIndex < cards.length; placedIndex++) {
+            var placed = cards[placedIndex];
+            result[placed.index] = {
+                x: placed.x + shift,
+                y: top + (row.height - placed.height) / 2,
+                width: placed.width,
+                height: placed.height,
+                row: rowKeys[rowIndex],
+                label: items[placed.index].label !== undefined ? items[placed.index].label : rowKeys[rowIndex]
+            };
+        }
+        top += row.height + gap;
+    }
+    return result;
+}
+
+// How far workspace rows can scroll. Vertically from minY to maxY: when the
+// rows are taller than the area, far enough to centre the first and the last
+// row, as niri centres any workspace. Each row horizontally between min and
+// max, which always include 0 (the row centred on its focused window) and
+// reach far enough to centre either end window, or to bring either end of the
+// row margin pixels inside the area.
+function rowsScrollLimits(rects, width, height, margin) {
+    var limits = { minY: 0, maxY: Math.max(0, (rects.contentHeight || 0) - height), rows: {} };
+    var spans = rowSpans(rects);
+    if (limits.maxY > 0 && spans.length) {
+        limits.minY = Math.min(0, spans[0].centre - height / 2);
+        limits.maxY = Math.max(limits.maxY, spans[spans.length - 1].centre - height / 2);
+    }
+    var ends = {};
+    for (var index = 0; index < rects.length; index++) {
+        var rect = rects[index];
+        if (!rect)
+            continue;
+        var key = String(rect.row);
+        var centre = rect.x + rect.width / 2;
+        if (!ends[key])
+            ends[key] = { left: rect.x, right: rect.x + rect.width, first: centre, last: centre };
+        ends[key].left = Math.min(ends[key].left, rect.x);
+        ends[key].right = Math.max(ends[key].right, rect.x + rect.width);
+        ends[key].first = Math.min(ends[key].first, centre);
+        ends[key].last = Math.max(ends[key].last, centre);
+    }
+    for (var row in ends) {
+        limits.rows[row] = {
+            min: Math.min(0, width - margin - ends[row].right, width / 2 - ends[row].last),
+            max: Math.max(0, margin - ends[row].left, width / 2 - ends[row].first)
+        };
+    }
+    return limits;
+}
+
+function clampedScroll(value, low, high) {
+    return Math.max(low, Math.min(high, value));
+}
+
+// The rows' rectangles moved by a vertical scroll and per-row horizontal
+// scrolls (scrollX maps row key to offset).
+function scrolledRows(rects, scrollY, scrollX) {
+    var result = [];
+    for (var index = 0; index < rects.length; index++) {
+        var rect = rects[index];
+        if (!rect)
+            continue;
+        result[index] = {
+            x: rect.x + ((scrollX && scrollX[String(rect.row)]) || 0),
+            y: rect.y - scrollY,
+            width: rect.width,
+            height: rect.height,
+            row: rect.row
+        };
+    }
+    result.contentHeight = rects.contentHeight;
+    return result;
+}
+
+// Scroll offsets that show card index whole, margin pixels inside the area,
+// moving as little as possible; with centre, its row is centred vertically
+// instead. Returns { y, x } with x a new per-row map.
+function revealInRows(rects, index, scrollY, scrollX, width, height, margin, centre) {
+    var x = {};
+    for (var key in scrollX || {})
+        x[key] = scrollX[key];
+    var rect = rects[index];
+    if (!rect)
+        return { y: scrollY, x: x };
+    var limits = rowsScrollLimits(rects, width, height, margin);
+
+    var y = scrollY;
+    if (centre) {
+        y = rect.y + rect.height / 2 - height / 2;
+    } else if (rect.y - y < margin) {
+        y = rect.y - margin;
+    } else if (rect.y + rect.height - y > height - margin) {
+        y = rect.y + rect.height - (height - margin);
+    }
+
+    var row = String(rect.row);
+    var offset = x[row] || 0;
+    var left = rect.x + offset;
+    if (left < margin)
+        offset += margin - left;
+    else if (left + rect.width > width - margin)
+        offset -= left + rect.width - (width - margin);
+    var rowLimits = limits.rows[row] || { min: 0, max: 0 };
+    x[row] = clampedScroll(offset, rowLimits.min, rowLimits.max);
+    return { y: clampedScroll(y, limits.minY, limits.maxY), x: x };
+}
+
+// The workspace rows from top to bottom, unscrolled:
+// { row, label, top, bottom, centre }.
+function rowSpans(rects) {
+    var byKey = {};
+    var spans = [];
+    for (var index = 0; index < rects.length; index++) {
+        var rect = rects[index];
+        if (!rect)
+            continue;
+        var key = String(rect.row);
+        if (!byKey[key]) {
+            byKey[key] = { row: rect.row, label: rect.label !== undefined ? String(rect.label) : key, top: rect.y, bottom: rect.y + rect.height };
+            spans.push(byKey[key]);
+        }
+        byKey[key].top = Math.min(byKey[key].top, rect.y);
+        byKey[key].bottom = Math.max(byKey[key].bottom, rect.y + rect.height);
+    }
+    spans.sort(function (a, b) { return a.top - b.top; });
+    for (var spanIndex = 0; spanIndex < spans.length; spanIndex++)
+        spans[spanIndex].centre = (spans[spanIndex].top + spans[spanIndex].bottom) / 2;
+    return spans;
+}
+
+// The index in rowSpans of the row nearest the middle of the area.
+function nearestRowIndex(rects, scrollY, height) {
+    var spans = rowSpans(rects);
+    var middle = scrollY + height / 2;
+    var nearest = spans.length ? 0 : -1;
+    for (var index = 1; index < spans.length; index++)
+        if (Math.abs(spans[index].centre - middle) < Math.abs(spans[nearest].centre - middle))
+            nearest = index;
+    return nearest;
+}
+
+// The vertical scroll that centres row index of rowSpans, within the limits.
+function centreRowScroll(rects, index, height) {
+    var spans = rowSpans(rects);
+    if (index < 0 || index >= spans.length)
+        return 0;
+    var limits = rowsScrollLimits(rects, 0, height, 0);
+    return clampedScroll(spans[index].centre - height / 2, limits.minY, limits.maxY);
+}
+
+// One scroll step through workspace rows, as in niri: the vertical scroll that
+// centres the row after (direction 1) or before (-1) the row nearest the middle
+// now, or that row itself when it sits off centre the other way. Rows the scroll limits cannot centre are passed over; past the last
+// row the scroll stays put.
+function stepRowsY(rects, scrollY, height, direction) {
+    var spans = rowSpans(rects);
+    var nearest = nearestRowIndex(rects, scrollY, height);
+    if (nearest < 0)
+        return scrollY;
+    // A row off centre in the step's direction is centred first.
+    var current = centreRowScroll(rects, nearest, height);
+    if ((current - scrollY) * direction > 0.5)
+        return current;
+    for (var target = nearest + direction; target >= 0 && target < spans.length; target += direction) {
+        var next = centreRowScroll(rects, target, height);
+        if (Math.abs(next - scrollY) > 0.5)
+            return next;
+    }
+    return scrollY;
+}
+
+// The centres of a row's windows, left to right, unscrolled.
+function rowWindowCentres(rects, row) {
+    var key = String(row);
+    var centres = [];
+    for (var index = 0; index < rects.length; index++)
+        if (rects[index] && String(rects[index].row) === key)
+            centres.push(rects[index].x + rects[index].width / 2);
+    centres.sort(function (a, b) { return a - b; });
+    return centres;
+}
+
+// The index in rowWindowCentres of the window nearest the middle at offset.
+function nearestWindowIndex(rects, row, offset, width) {
+    var centres = rowWindowCentres(rects, row);
+    var middle = width / 2 - offset;
+    var nearest = centres.length ? 0 : -1;
+    for (var index = 1; index < centres.length; index++)
+        if (Math.abs(centres[index] - middle) < Math.abs(centres[nearest] - middle))
+            nearest = index;
+    return nearest;
+}
+
+// The row's horizontal offset that centres its window index, within the limits.
+function centreWindowOffset(rects, row, index, width, margin) {
+    var centres = rowWindowCentres(rects, row);
+    if (index < 0 || index >= centres.length)
+        return 0;
+    var limits = rowsScrollLimits(rects, width, 0, margin).rows[String(row)] || { min: 0, max: 0 };
+    return clampedScroll(width / 2 - centres[index], limits.min, limits.max);
+}
+
+// One scroll step along a row: the row's horizontal offset that centres the
+// window after (direction 1) or before (-1) the one nearest the middle now.
+function stepRowX(rects, row, scrollX, width, margin, direction) {
+    var key = String(row);
+    var offset = (scrollX && scrollX[key]) || 0;
+    var count = rowWindowCentres(rects, row).length;
+    var nearest = nearestWindowIndex(rects, row, offset, width);
+    if (nearest < 0)
+        return offset;
+    var current = centreWindowOffset(rects, row, nearest, width, margin);
+    if ((offset - current) * direction > 0.5)
+        return current;
+    for (var target = nearest + direction; target >= 0 && target < count; target += direction) {
+        var next = centreWindowOffset(rects, row, target, width, margin);
+        if (Math.abs(next - offset) > 0.5)
+            return next;
+    }
+    return offset;
+}
